# Python cache and local metadata
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.DS_Store
.nfs*

# Local tool state / virtual environments
.claude/
.codex
.codex_plot_env/
.codex_plot_env2/
.runtime_cache/
torchinductor_*/
.git_worktrees/
.venvs/
.venv/
venv/
env/

# Logs and scheduler output
*.out
*.err
slurm-*.out
logs/
logs_archive/
archives/

# Large local data and experiment outputs
data/

# Keep generated experiment results and locks out of git even if data/ is later relaxed
data/results/
data/local_cache/
data/cache/
data/pie_cpp/

# Explicitly keep project configs, even if a global ignore rule excludes JSON
!configs/
!configs/*.json
!configs/*.yaml

# Analysis / one-off scripts should stay local
artifacts/analysis/
artifacts/experiment_configs/
artifacts/rebuttal_tools/

# Local utility outputs
*.md
!README.md
!docs/*.md
!configs/README.md
!examples/README.md
!artifacts/phase1_if/README.md
figures/
REBUTTAL.md
WORKLOG.md
WORKLOG_*.md
docs/worklogs/

# Root-level scratch files
appendix_full_qq_check.pdf
gaussian_tail_check.pdf
optimized_code.txt
output.txt
test_input.txt
test_*.py
!tests/test_*.py
*.bak_*
*.lock
phase1_transfer/

# Phase 1 auxiliary helpers that are not part of the core runtime path
artifacts/phase1/summarize_phase1_results.py

# Generated phase1_if outputs should stay local, but scripts/runbook should remain trackable
artifacts/phase1_if/__pycache__/
artifacts/phase1_if/debug/
artifacts/phase1_if/full_runs/
artifacts/phase1_if/arena_hard_ablation/
artifacts/phase1_if/runs/
