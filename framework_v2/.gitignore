# Python cache and local metadata
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.DS_Store
.nfs*

# Local tool state / virtual environments
.claude/
.codex_plot_env/
.codex_plot_env2/
.venv/
venv/
env/

# Logs and scheduler output
*.out
*.err
slurm-*.out
logs/
logs_archive/
archives/

# Large local data and experiment outputs
data/

# Keep generated experiment results and locks out of git even if data/ is later relaxed
data/results/
data/local_cache/

# Explicitly keep project configs, even if a global ignore rule excludes JSON
!configs/
!configs/*.json
!configs/*.yaml

# Analysis / one-off scripts should stay local
artifacts/analysis/
artifacts/experiment_configs/
artifacts/rebuttal_tools/

# Local utility outputs
*.md
figures/
REBUTTAL.md
WORKLOG.md
WORKLOG_*.md
docs/worklogs/

# Root-level scratch files
appendix_full_qq_check.pdf
gaussian_tail_check.pdf
optimized_code.txt
output.txt
test_input.txt
test_*.py

# Phase 1 auxiliary helpers that are not part of the core runtime path
artifacts/phase1/summarize_phase1_results.py
